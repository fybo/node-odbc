{
  "name": "odbc",
  "description": "unixodbc bindings for node",
  "version": "2.4.7",
  "homepage": "https://github.com/fybo/node-odbc/",
  "main": "lib/odbc.js",
  "types": "lib/odbc.d.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/fybo/node-odbc.git"
  },
  "bugs": {
    "url": "https://github.com/fybo/node-odbc/issues"
  },
  "contributors": [
    {
      "name": "Mark Irish",
      "email": "mirish@ibm.com"
    },
    {
      "name": "Dan VerWeire",
      "email": "dverweire@gmail.com"
    },
    {
      "name": "Lee Smith",
      "email": "notwink@gmail.com"
    }
  ],
  "license": "MIT",
  "directories": {
    "lib": "."
  },
  "engines": {
    "node": ">=10.19.0"
  },
  "scripts": {
    "install": "node-pre-gyp install --fallback-to-build",
    "test": "mocha --slow 5000 --timeout 30000",
    "build": "node-pre-gyp rebuild --msvs_version=2017 --build-from-source --update-binary",
    "build-dev": "node-pre-gyp rebuild --msvs_version=2017 --build-from-source --update-binary --debug",
    "start": "node index.js"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "2.0.0",
    "async": "^3.0.1",
    "node-addon-api": "8.3.1"
  },
  "gypfile": true,
  "devDependencies": {
    "dotenv": "^6.2.0",
    "eslint": "^8.11.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.4",
    "mocha": "^9.2.2"
  },
  "binary": {
    "module_name": "odbc",
    "module_path": "./lib/bindings/napi-v{napi_build_version}",
    "host": "https://github.com/fybo/node-odbc/releases/download/v{version}",
    "package_name": "{name}-v{version}-{platform}-{arch}-napi-v{napi_build_version}.tar.gz",
    "napi_versions": [9]
  }
}
